<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.familybot.portal</string>
  <key>ProgramArguments</key>
  <array>
    <string>__FAMILYBOT_RUNTIME__/.venv/bin/python</string>
    <string>__FAMILYBOT_RUNTIME__/local_service/run_service.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__FAMILYBOT_RUNTIME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>FAMILYBOT_NODE</key>
    <string>__FAMILYBOT_NODE__</string>
    <key>FAMILYBOT_WORKSPACE</key>
    <string>__FAMILYBOT_WORKSPACE__</string>
    <key>FAMILYBOT_FAMILY_CONFIG</key>
    <string>__FAMILYBOT_CONFIG__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_ACCOUNT/Library/Logs/familybot-portal.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_ACCOUNT/Library/Logs/familybot-portal.error.log</string>
</dict>
</plist>
