{
  "name": "familybot-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "docs:check": "python3 scripts/validate_docs.py",
    "dev": "vite dev",
    "dev:web": "vite dev",
    "dev:api": "python3 local_api/familybot_api.py",
    "dev:family": "bash scripts/dev-family.sh",
    "hellofresh:contract:check": "python3 scripts/check_hellofresh_contract.py",
    "build": "vite build",
    "start": "vinext start",
    "start:lan": "vinext start --hostname 0.0.0.0 --port 3000",
    "start:service": "python3 local_service/run_service.py",
    "preflight": "bash scripts/preflight.sh",
    "security:audit": "npm audit --audit-level=low && bash scripts/python-quality.sh security",
    "typecheck": "tsc --noEmit",
    "test": "npm run security:audit && python3 scripts/test_api.py && npm run docs:check && npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "npm run lint:web && bash scripts/python-quality.sh lint",
    "lint:web": "oxlint --react-plugin --jsx-a11y-plugin --nextjs-plugin --deny-warnings -A jsx-a11y/prefer-tag-over-role -A unicorn/prefer-string-starts-ends-with -A unicorn/no-useless-fallback-in-spread -D react-hooks/rules-of-hooks -D react-hooks/exhaustive-deps --ignore-pattern dist --ignore-pattern .next ."
  },
  "dependencies": {
    "@dnb/eufemia": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxlint": "1.90.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vinext": "^1.4.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "type": "module"
}
